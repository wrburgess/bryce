<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.sk.backup</string>
  <key>WorkingDirectory</key><string>BRYCE_ROOT</string>
  <key>ProgramArguments</key><array><string>/bin/zsh</string><string>-lc</string><string>mkdir -p "BRYCE_ROOT/logs" &amp;&amp; npm run db:backup &gt;&gt; "BRYCE_ROOT/logs/backup.log" 2&gt;&amp;1</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
</dict></plist>
